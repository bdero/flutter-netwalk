namespace netwalk.fb;

enum NodeType: byte {
  Wire = 0,
  Source = 1,
  Sink = 2,
}

struct Node {
  type: NodeType;
  locked: bool;
  rotation: int;  // Clockwise: 0=0deg, 1=90deg, 2=180deg, 3=270deg
  arms: ubyte;  // Bitmask: bit 0=Up, bit 1=Right, bit 2=Down, bit 3=Left
  connected: bool;
}

table NetwalkBoard {
  board_width: int;
  board_height: int;
  nodes: [Node];  // Left to right, top to bottom. Size is board_width * board_height.
}

root_type NetwalkBoard;
